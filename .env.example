# ─────────────────────────────────────────────────────────────
# DELIS CRM — переменные окружения
# Скопируйте этот файл в `.env` и заполните значения:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL. Обязательная переменная — без неё приложение не стартует.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Пароль владельца, создаётся при первичном сиде БД (логин: owner).
# Если не задан — используется значение по умолчанию `delis2026`.
# ОБЯЗАТЕЛЬНО смените перед деплоем на прод.
OWNER_PASSWORD=delis2026

# Пароль демо-сотрудников (логины: admin, manager, warehouse, support, agent).
# Нужны, чтобы проверять разграничение прав вживую. Отдельно от пароля
# владельца, чтобы аккаунты не делили один секрет.
# На боевом сервере задайте свой или удалите эти аккаунты.
DEMO_PASSWORD=delis2026

# ─── Загрузка файлов ────────────────────────────────────────
# Драйвер хранения: `local` (по умолчанию) или `s3`/`r2` для объектного
# хранилища (AWS S3, Cloudflare R2, MinIO и др.).
# STORAGE_DRIVER=local

# Для STORAGE_DRIVER=local:
# Каталог для загруженных файлов. По умолчанию `public/uploads`,
# откуда Next отдаёт их как статику.
# На платформах с эфемерной файловой системой (Vercel и т.п.) укажите
# путь к постоянному тому — иначе файлы пропадут при передеплое.
# UPLOAD_DIR=/var/lib/delis/uploads

# Публичный префикс URL, под которым отдаются файлы (например, CDN).
# UPLOAD_PUBLIC_PREFIX=/uploads

# Для STORAGE_DRIVER=s3:
# Endpoint S3-совместимого хранилища. Для Cloudflare R2 это
# https://<account_id>.r2.cloudflarestorage.com
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=delis-uploads
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Регион подписи. Для R2 задайте `auto`, для MinIO — `us-east-1`.
# S3_REGION=us-east-1
# Стиль адресации. По умолчанию path-style (R2, MinIO); для AWS S3
# задайте `false` (virtual-host).
# S3_FORCE_PATH_STYLE=true
# Публичный URL файлов (CDN / кастомный домен / публичный бакет).
# Если не задан — URL собирается из endpoint и имени бакета.
# S3_PUBLIC_BASE_URL=https://cdn.delis.uz

# ─── Обратный прокси ────────────────────────────────────────
# Установите в 1, только если приложение работает за прокси (nginx, Vercel,
# балансировщик), который САМ перезаписывает x-forwarded-for. Тогда лимит
# попыток входа считается по реальному IP клиента.
# При прямом подключении оставьте выключенным: заголовок подделывается
# клиентом, и лимит по паре логин+IP обходился бы сменой значения.
# TRUST_PROXY=1
