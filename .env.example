# ─────────────────────────────────────────────────────────────
# DELIS CRM — переменные окружения
# Скопируйте этот файл в `.env` и заполните значения:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL. Обязательная переменная — без неё приложение не стартует.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Пароль владельца, создаётся при первичном сиде БД (логин: owner).
# Если не задан — используется значение по умолчанию `delis2026`.
# ОБЯЗАТЕЛЬНО смените перед деплоем на прод.
OWNER_PASSWORD=delis2026

# ─── Загрузка файлов ────────────────────────────────────────
# Каталог для загруженных файлов. По умолчанию `public/uploads`,
# откуда Next отдаёт их как статику.
# На платформах с эфемерной файловой системой (Vercel и т.п.) укажите
# путь к постоянному тому — иначе файлы пропадут при передеплое.
# UPLOAD_DIR=/var/lib/delis/uploads

# Публичный префикс URL, под которым отдаются файлы (например, CDN).
# UPLOAD_PUBLIC_PREFIX=/uploads
